{
  "name": "PNCND_CAP_DM",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.12",
    "@cap-js/postgres": "^2.3.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "impl": "@cap-js/postgres",
        "dialect": "postgres",
        "credentials": {
          "ssl": {
            "ca": "./Root_combined.pem",
            "rejectUnauthorized": true
          }
        },
        "pool": {
          "min": 0,
          "max": 10,
          "acquireTimeoutMillis": 30000,
          "idleTimeoutMillis": 10000,
          "reapIntervalMillis": 1000,
          "createTimeoutMillis": 10000,
          "destroyTimeoutMillis": 5000
        }
      }
    },
    "auth": "dummy"
  }
}
